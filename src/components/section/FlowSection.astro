---
interface Props {
  title: string;
  intro?: string;
  steps: { title: string; body: string }[];
}
const { title, intro, steps } = Astro.props;
---

<section class="block">
  <h2>{title}</h2>
  {intro && <p class="intro">{intro}</p>}
  <ol>
    {
      steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .block { display: flex; flex-direction: column; gap: 16px; }
  h2 { margin: 0; font-family: var(--dr-font-head); font-weight: 600; font-size: 28px; color: var(--dr-navy); }
  .intro { margin: 0; max-width: 720px; color: var(--dr-text); }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; counter-reset: step; }
  li { counter-increment: step; padding: 20px; background: #fff; border: 1px solid var(--dr-border); border-radius: 12px; }
  li::before { content: counter(step); display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; margin-bottom: 10px; border-radius: 50%; background: var(--dr-accent); color: #fff; font-family: var(--dr-font-mono); font-size: 13px; font-weight: 500; }
  h3 { margin: 0 0 6px; font-family: var(--dr-font-head); font-weight: 600; font-size: 17px; color: var(--dr-navy); }
  p { margin: 0; color: var(--dr-text); }
</style>
