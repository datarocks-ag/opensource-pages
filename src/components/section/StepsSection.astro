---
import CommandLine from '../CommandLine.astro';

interface Props {
  title: string;
  items: { title: string; body: string; code?: string }[];
}
const { title, items } = Astro.props;
---

<section class="block">
  <h2>{title}</h2>
  <ol>
    {
      items.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.code && <CommandLine command={item.code} />}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .block { display: flex; flex-direction: column; gap: 16px; }
  h2 { margin: 0; font-family: var(--dr-font-head); font-weight: 600; font-size: 28px; color: var(--dr-navy); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; counter-reset: step; }
  li { counter-increment: step; display: flex; flex-direction: column; gap: 8px; padding: 20px 20px 20px 64px; position: relative; background: #fff; border: 1px solid var(--dr-border); border-radius: 12px; }
  li::before { content: counter(step); position: absolute; left: 20px; top: 20px; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: var(--dr-accent); color: #fff; font-family: var(--dr-font-mono); font-size: 13px; }
  h3 { margin: 0; font-family: var(--dr-font-head); font-weight: 600; font-size: 17px; color: var(--dr-navy); }
  p { margin: 0; color: var(--dr-text); }
</style>
