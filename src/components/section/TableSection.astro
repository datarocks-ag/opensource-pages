---
interface Props {
  title: string;
  intro?: string;
  columns: string[];
  rows: string[][];
}
const { title, intro, columns, rows } = Astro.props;
---

<section class="block">
  <h2>{title}</h2>
  {intro && <p class="intro">{intro}</p>}
  <div class="scroll" style="overflow-x:auto" tabindex="0" role="region" aria-label={title}>
    <table>
      <thead>
        <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
      </tbody>
    </table>
  </div>
</section>

<style>
  .block { display: flex; flex-direction: column; gap: 16px; }
  h2 { margin: 0; font-family: var(--dr-font-head); font-weight: 600; font-size: 28px; color: var(--dr-navy); }
  .intro { margin: 0; max-width: 720px; color: var(--dr-text); }
  .scroll { border: 1px solid var(--dr-border); border-radius: 12px; background: #fff; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { padding: 12px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--dr-border); }
  th { background: var(--dr-tint); color: var(--dr-navy); font-family: var(--dr-font-head); font-weight: 600; font-size: 14px; white-space: nowrap; }
  td { color: var(--dr-text); }
  tbody tr:last-child td { border-bottom: 0; }
</style>
