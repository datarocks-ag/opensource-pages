---
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<section class="band">
  <div class="inner">
    <div class="copy">
      <h2>{title}</h2>
      {text && <p>{text}</p>}
    </div>
    <a href="https://datarocks.ch">Visit datarocks.ch →</a>
  </div>
</section>

<style>
  .band {
    background: var(--dr-navy);
    color: #fff;
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 32px;
    box-sizing: border-box;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 720px;
  }
  h2 {
    margin: 0;
    font-family: var(--dr-font-head);
    font-weight: 600;
    font-size: 26px;
    color: #fff;
  }
  p {
    margin: 0;
    font-size: 17px;
    color: #dcdcf5;
  }
  a {
    padding: 14px 22px;
    border-radius: 8px;
    background: #fff;
    color: var(--dr-navy);
    font-weight: 700;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    background: var(--dr-tint);
  }
  @media (max-width: 640px) {
    .inner {
      padding: 40px 16px;
    }
  }
</style>
