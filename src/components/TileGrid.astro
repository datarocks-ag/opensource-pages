---
const NAVY = '#0A017B';
const BLUE = '#1301E9';
const kinds = {
  split: { left: NAVY, right: BLUE, stroke: 'none', bg: '#FFFFFF' },
  half: { left: 'none', right: BLUE, stroke: 'none', bg: '#FFFFFF' },
  navy: { left: NAVY, right: 'none', stroke: 'none', bg: '#FFFFFF' },
  ring: { left: 'none', right: 'none', stroke: '#C6C8DC', bg: '#FFFFFF' },
  solid: { left: '#FFFFFF', right: '#CACCF2', stroke: 'none', bg: BLUE },
  empty: { left: 'none', right: 'none', stroke: 'none', bg: '#EEEFF9' },
} as const;
const layout: [keyof typeof kinds, number][] = [
  ['split', 0], ['half', 90], ['ring', 0], ['navy', 180],
  ['half', 270], ['solid', 0], ['split', 90], ['empty', 0],
  ['ring', 0], ['navy', 90], ['half', 180], ['split', 270],
  ['split', 180], ['empty', 0], ['half', 0], ['ring', 0],
];
const tiles = layout.map(([kind, rot]) => ({ ...kinds[kind], rot }));
---

<div class="dr-tiles" aria-hidden="true">
  {
    tiles.map((t) => (
      <div class="tile" style={`background:${t.bg};transform:rotate(${t.rot}deg)`}>
        <svg viewBox="0 0 96 96">
          <path d="M48 6 A42 42 0 0 0 48 90 Z" fill={t.left} />
          <path d="M48 6 A42 42 0 0 1 48 90 Z" fill={t.right} />
          <circle cx="48" cy="48" r="41" fill="none" stroke={t.stroke} stroke-width="2" />
        </svg>
      </div>
    ))
  }
</div>

<!-- is:inline so the reduced-motion rule ships with the markup. -->
<style is:inline>
  .dr-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .dr-tiles .tile {
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dr-tiles .tile svg {
    width: 78%;
    height: 78%;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .dr-tiles .tile:hover svg {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .dr-tiles .tile svg {
      transition: none;
    }
    .dr-tiles .tile:hover svg {
      transform: none;
    }
  }
</style>
