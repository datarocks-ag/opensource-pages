---
/**
 * Project switcher for the docs: one option per sidebar topic (project docs and the provisioner
 * guides), the current one selected. Choosing an option opens that topic's first page.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { isPageWithTopic, topics } = Astro.locals.starlightSidebarTopics;
---

{
  isPageWithTopic && (
    <select class:list={['dr-docs-selector', className]} aria-label="Project docs" data-docs-selector>
      {topics.map((topic) => (
        <option value={topic.link} selected={topic.isCurrent}>
          {topic.label}
        </option>
      ))}
    </select>
  )
}

<script>
  for (const select of document.querySelectorAll<HTMLSelectElement>('[data-docs-selector]')) {
    select.addEventListener('change', () => window.location.assign(select.value));
  }
</script>

<style>
  .dr-docs-selector {
    min-width: 0;
    max-width: 22rem;
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    font-family: var(--dr-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
    background-color: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .dr-docs-selector:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
