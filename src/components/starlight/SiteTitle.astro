---
import DocsSelector from './DocsSelector.astro';

/** Docs header title: the Data Rocks logo plus "/ docs", linking back to the landing page, and the project selector. */
---

<a href="/" class="dr-site-title">
  <img src="/datarocks-logo.svg" alt="Data Rocks" height="24" />
  <span class="dr-site-title__docs" aria-hidden="true">/ docs</span>
  <span class="sr-only">docs</span>
</a>
<DocsSelector class="sl-hidden md:sl-flex" />

<style>
  /*
   * Inline layout so "/ docs" sits on the wordmark's baseline: the wordmark's baseline is at 79.5%
   * of the logo's height, so the logo drops by the remaining 20.5% below the text baseline.
   */
  .dr-site-title {
    white-space: nowrap;
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .dr-site-title img {
    display: inline-block;
    height: 1.5rem;
    width: auto;
    vertical-align: calc(1.5rem * -0.205);
  }
  .dr-site-title__docs {
    margin-inline-start: 0.5rem;
    font-family: var(--dr-font-mono);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  /* The logo SVG is dark; keep it legible on the dark theme. */
  :global([data-theme='dark']) .dr-site-title img {
    filter: brightness(0) invert(1);
  }
</style>
