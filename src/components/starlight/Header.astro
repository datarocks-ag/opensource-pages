---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Starlight's header with the search moved to the right, next to the GitHub link and theme switch,
 * so the left side holds the logo and the project selector (see the canvas Docs design).
 */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="right-group sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex social-icons"><SocialIcons /></div>
    <div class="sl-hidden md:sl-flex theme-select"><ThemeSelect /></div>
    <div class="sl-hidden md:sl-flex"><LanguageSelect /></div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
    overflow: clip;
    /* Avoid clipping focus ring around the title link and selector. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    gap: 1rem;
    align-items: center;
  }

  /* Takes the free space so the search can grow; its items stay right-aligned. */
  .right-group {
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  /*
   * Starlight sizes the search button to its container; in the right group that is only its label.
   * It shrinks well before the project selector does, so narrow desktops keep the project readable.
   */
  @media (min-width: 50rem) {
    .right-group :global(button[data-open-modal]) {
      flex: 0 1 22rem;
      min-width: 10rem;
      max-width: 22rem;
    }
  }
  /*
   * Icon-only theme switch: keep Starlight's native select (keyboard and screen-reader support,
   * stored preference) but hide its text and caret, leaving the sun / moon / laptop icon.
   */
  .theme-select :global(label) {
    --sl-label-icon-size: 1rem;
  }
  .theme-select :global(.label-icon) {
    inset-inline-start: 0.5rem;
  }
  .theme-select :global(.caret) {
    display: none;
  }
  .theme-select :global(select) {
    width: 2rem;
    margin-inline: 0;
    padding-inline: 0;
    color: transparent;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
