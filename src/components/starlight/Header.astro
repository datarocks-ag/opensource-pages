---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

/**
 * Starlight's header with the search moved to the right, next to the GitHub link and theme switch,
 * so the left side holds the logo and the project selector (see the canvas Docs design).
 */
const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper sl-flex"><SiteTitle /></div>
  <div class="right-group sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
    <div class="sl-hidden md:sl-flex social-icons"><SocialIcons /></div>
    <div class="sl-hidden md:sl-flex"><ThemeSelect /></div>
    <div class="sl-hidden md:sl-flex"><LanguageSelect /></div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    /* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
    overflow: clip;
    /* Avoid clipping focus ring around the title link and selector. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
    gap: 1rem;
    align-items: center;
  }

  .right-group,
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }
</style>
